# Copy to `.env` at the repo root. Never commit real secrets.

ENVIRONMENT=development
SECRET_KEY=generate_a_random_string_here
ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

SEED_DEMO=false

POSTGRES_SERVER=localhost
POSTGRES_PORT=5445
POSTGRES_DB=nidus_billing
POSTGRES_TEST_DB=nidus_billing_test

APP_USER=nidus_billing_app
APP_PASSWORD=change_me_in_real_env

ADMIN_USER=nidus_billing_admin
ADMIN_PASSWORD=change_me_in_real_env

FRONTEND_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:8001

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_STRICT_MAX=10
RATE_LIMIT_MODERATE_MAX=30

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Nidus Billing
EMAIL_FROM_ADDRESS=noreply@nidus.local

# CREDENTIALS_ENCRYPTION_KEY=
# HACIENDA_LIVE=false
# HACIENDA_XADES_POLICY_ID=
# HACIENDA_XADES_POLICY_DIGEST=

# COOKIE_SECURE=true

# Optional: host port published for the API container (default 8001)
# API_PORT=8001
