# Copy to `.env` at the repo root. Never commit real secrets.

ENVIRONMENT=development
SECRET_KEY=generate_a_random_string_here
ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

SEED_DEMO=false

POSTGRES_SERVER=localhost
# Host port (Billing default 5445 so Core can keep 5444 side by side)
POSTGRES_PORT=5445
POSTGRES_DB=nidus_billing
POSTGRES_TEST_DB=nidus_billing_test

APP_USER=nidus_billing_app
APP_PASSWORD=change_me_in_real_env

ADMIN_USER=nidus_billing_admin
ADMIN_PASSWORD=change_me_in_real_env

# FE default 3001 if Core FE already uses 3000
FRONTEND_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:8001

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_STRICT_MAX=10
RATE_LIMIT_MODERATE_MAX=30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_mail@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM_NAME=Nidus Billing
EMAIL_FROM_ADDRESS=noreply@example.com

# COOKIE_SECURE=true

# Optional: host port published for the API container (default 8001)
# API_PORT=8001
